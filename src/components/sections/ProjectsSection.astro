---
import ProjectCard from '@/components/ProjectCard.astro';
import { projects } from '@/data/projects';

const skillCategories = [
  {
    title: 'Languages',
    skills: ['Python', 'TypeScript', 'JavaScript', 'C#', 'SQL', 'Kotlin', 'HTML/CSS']
  },
  {
    title: 'AI & Data',
    skills: ['LLM Agents', 'RAG', 'Vector Search', 'NLP', 'Prompt/Context Engineering', 'PostgreSQL', 'Supabase', 'Firestore']
  },
  {
    title: 'Frameworks & Backend',
    skills: ['FastAPI', 'ASP.NET Core', 'Node.js', 'NestJS', 'Next.js', 'React', 'GraphQL', 'PyTorch', 'Jetpack Compose', 'Astro', 'Tailwind CSS']
  },
  {
    title: 'Cloud & DevOps',
    skills: ['Git', 'GCP (Cloud Run)', 'Vercel', 'DigitalOcean']
  }
];

// Icon mapping for skills - using Simple Icons color scheme
const skillIcons: Record<string, string> = {
  // Languages
  'Python': '#3776AB',
  'TypeScript': '#3178C6',
  'JavaScript': '#F7DF1E',
  'C#': '#239120',
  'SQL': '#4479A1',
  'Kotlin': '#7F52FF',
  'HTML/CSS': '#E34F26',
  // AI & Data — the conceptual ones have no brand colour, so they take the
  // site's purple rather than an invented logo colour
  'LLM Agents': 'rgb(153, 82, 228)',
  'RAG': 'rgb(153, 82, 228)',
  'Vector Search': 'rgb(153, 82, 228)',
  'NLP': 'rgb(153, 82, 228)',
  'Prompt/Context Engineering': 'rgb(153, 82, 228)',
  'PostgreSQL': '#4169E1',
  'Supabase': '#3ECF8E',
  'Firestore': '#FFCA28',
  // Frameworks & Backend
  'FastAPI': '#009688',
  'ASP.NET Core': '#512BD4',
  'Node.js': '#339933',
  'NestJS': '#E0234E',
  'Next.js': '#FFFFFF',
  'React': '#61DAFB',
  'GraphQL': '#E10098',
  'PyTorch': '#EE4C2C',
  'Jetpack Compose': '#4285F4',
  'Astro': '#FF5D01',
  'Tailwind CSS': '#06B6D4',
  // Cloud & DevOps
  'Git': '#F05032',
  'GCP (Cloud Run)': '#4285F4',
  'Vercel': '#FFFFFF',
  'DigitalOcean': '#0080FF'
};
---

<section id="projects">
  <div class="container">
    <h2 class="section-title" data-ghost="WORK">Projects</h2>
    
    <div class="skills-section">
      <h3 class="skills-title">SKILLS</h3>
      <div class="divider"></div>
      <div class="skills-categories">
        {skillCategories.map((category) => (
          <div class="skill-category">
            <div class="category-title">{category.title}</div>
            <div class="skills-list">
              {category.skills.map((skill) => (
                <button
                  class="skill-tag"
                  data-skill={skill}
                  aria-label={`Filter projects by ${skill}`}
                >
                  <span class="skill-icon" style={`background-color: ${skillIcons[skill] || '#666'}`}></span>
                  {skill}
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
    
    <div class="filter-bar">
      <p class="filter-count" id="filter-count" role="status" aria-live="polite"></p>
      <button class="clear-filter" id="clear-filter" style="display: none;">
        Clear Filter
      </button>
    </div>

    <p class="no-results" id="no-results" hidden>
      Nothing matches every one of those at once. Try removing a filter.
    </p>

    <div class="projects-grid" id="projects-grid">
      {projects.map((project) => (
        <div class="project-wrapper" data-tags={project.tags?.join(',') || ''}>
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    min-height: 100vh;
    padding: 4rem 2rem 25vh 2rem;
    margin-top: 4rem;
    background-color: #0a0a0a;
    background-image: linear-gradient(to bottom, #000000 0, #0a0a0a var(--seam));
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .skills-section {
    display: flex;
    gap: 2rem;
    margin-bottom: 2.5rem;
    padding: 0.5rem 0;
  }

  .skills-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: white;
    margin: 0;
    writing-mode: vertical-rl;
    text-orientation: upright;
    letter-spacing: 0.15em;
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .divider {
    width: 1px;
    min-height: 100%;
    background-color: #333;
    flex-shrink: 0;
  }

  .skills-categories {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .skill-category {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .category-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.45rem;
  }

  .skill-tag {
    background-color: white;
    color: #1a1a1a;
    font-size: 0.8rem;
    padding: 0.32rem 0.62rem;
    border-radius: 7px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.25s ease,
      color 0.25s ease,
      transform 0.25s ease;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .skill-icon {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .skill-tag:hover {
    background-color: rgb(153, 82, 228);
    color: white;
  }

  .skill-tag.active {
    background-color: rgb(153, 82, 228);
    color: white;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 1.25rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid #232327;
  }

  .filter-count {
    margin: 0;
    font-size: 0.85rem;
    color: #8f8f97;
    min-height: 1.2em;
  }

  .filter-count strong {
    color: rgb(153, 82, 228);
    font-weight: 600;
  }

  .no-results {
    margin: 0 0 1.5rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid #2a2a2e;
    border-radius: 10px;
    background-color: rgba(255, 255, 255, 0.02);
    color: #b0b0b8;
    font-size: 0.95rem;
  }

  .no-results[hidden] {
    display: none;
  }

  .clear-filter {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background-color: #1a1a1a;
    color: white;
    border: 1px solid #333;
    border-radius: 6px;
    cursor: pointer;
    font-size: 0.875rem;
    transition: all 0.3s ease;
    align-self: flex-start;
    white-space: nowrap;
  }

  .clear-filter:hover {
    background-color: #2a2a2a;
    border-color: #666;
  }

  .project-wrapper {
    transition:
      opacity 0.42s cubic-bezier(0.33, 1, 0.68, 1),
      filter 0.42s cubic-bezier(0.33, 1, 0.68, 1);
    order: 0;
  }

  .project-wrapper.filtered-out {
    order: 1;
    opacity: 0.3;
  }

  .project-wrapper.filtered-out :global(.project-card) {
    filter: grayscale(100%);
  }

  .projects-grid {
    display: grid;
    /* Six units, so the two lead projects take half a row each and the
       remaining nine fall into exact thirds: 2 + 3 + 3 + 3. The old
       three-column grid left an eleventh card orphaned in a half-empty row. */
    grid-template-columns: repeat(6, 1fr);
    gap: 1.5rem;
  }

  .projects-grid > :global(.project-wrapper) {
    grid-column: span 2;
  }

  .projects-grid > :global(.project-wrapper:nth-child(-n + 2)) {
    grid-column: span 3;
  }

  /* Mobile Responsiveness */
  @media (max-width: 768px) {
    section {
      padding: 2rem 1rem 15vh 1rem;
    }


    .skills-section {
      flex-direction: column;
      gap: 1rem;
    }

    .skills-title {
      writing-mode: horizontal-tb;
      text-orientation: mixed;
      height: auto;
    }

    .divider {
      display: none;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .projects-grid > :global(.project-wrapper),
    .projects-grid > :global(.project-wrapper:nth-child(-n + 2)) {
      grid-column: span 1;
    }
  }

  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .projects-grid > :global(.project-wrapper),
    .projects-grid > :global(.project-wrapper:nth-child(-n + 2)) {
      grid-column: span 1;
    }
  }

  @media (max-width: 768px) {
    .skills-section {
      flex-direction: column;
      gap: 1rem;
    }

    .divider {
      width: 100%;
      height: 1px;
      min-height: 1px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }

    .projects-grid > :global(.project-wrapper),
    .projects-grid > :global(.project-wrapper:nth-child(-n + 2)) {
      grid-column: span 1;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const skillTags = document.querySelectorAll('.skill-tag');
    const projectWrappers = document.querySelectorAll('.project-wrapper');
    const clearFilterBtn = document.getElementById('clear-filter');
    const countEl = document.getElementById('filter-count');
    const emptyEl = document.getElementById('no-results');
    let activeSkills: Set<string> = new Set();

    function updateFilter() {
      // Update visual state of skill tags
      skillTags.forEach(tag => {
        const skill = tag.getAttribute('data-skill');
        if (skill && activeSkills.has(skill)) {
          tag.classList.add('active');
        } else {
          tag.classList.remove('active');
        }
      });

      // Filter and reorder projects
      if (activeSkills.size === 0) {
        // No filters active - show all projects normally
        projectWrappers.forEach(wrapper => {
          wrapper.classList.remove('filtered-out');
        });
        if (clearFilterBtn) {
          clearFilterBtn.style.display = 'none';
        }
        setStatus(projectWrappers.length);
      } else {
        // Filters active - show projects that match ALL of the active skills
        projectWrappers.forEach(wrapper => {
          const tags = wrapper.getAttribute('data-tags')?.split(',') || [];
          const hasAllActiveSkills = Array.from(activeSkills).every(skill => tags.includes(skill));

          if (hasAllActiveSkills) {
            wrapper.classList.remove('filtered-out');
          } else {
            wrapper.classList.add('filtered-out');
          }
        });
        if (clearFilterBtn) {
          clearFilterBtn.style.display = 'block';
        }
        const matched = document.querySelectorAll('.project-wrapper:not(.filtered-out)').length;
        setStatus(matched);
      }
    }

    // Says how many projects survived the filter, and speaks up when none did.
    function setStatus(matched: number) {
      const total = projectWrappers.length;
      if (countEl) {
        countEl.innerHTML = activeSkills.size === 0
          ? `Showing all <strong>${total}</strong> projects`
          : `Showing <strong>${matched}</strong> of ${total}`;
      }
      if (emptyEl) emptyEl.hidden = matched !== 0;
    }

    function toggleSkill(skill: string) {
      if (activeSkills.has(skill)) {
        activeSkills.delete(skill);
      } else {
        activeSkills.add(skill);
      }
      updateFilter();
    }

    function clearFilter() {
      activeSkills.clear();
      updateFilter();
    }

    // Add click handlers to skill tags
    skillTags.forEach(tag => {
      tag.addEventListener('click', () => {
        const skill = tag.getAttribute('data-skill');
        if (skill) {
          toggleSkill(skill);
        }
      });
    });

    // Add click handler to clear filter button
    if (clearFilterBtn) {
      clearFilterBtn.addEventListener('click', clearFilter);
    }

    updateFilter(); // paint the initial count
  });
</script>
