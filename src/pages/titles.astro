---
/**
 * Section-title options, round two. Disposable — delete once a direction is picked.
 * Each idea is shown on the two background colours the real sections use.
 * Everything animates on entry; hit Replay to see it again.
 */
import '../styles/globals.css';

const samples = [
  { name: 'Projects', ghost: 'WORK', cmd: 'cd projects', bg: '#0a0a0a' },
  { name: 'About Me', ghost: 'WHO', cmd: 'cat about.txt', bg: '#1a1a1a' },
];

const ideas = [
  {
    id: 'redact',
    name: 'E. Redaction lift',
    why: 'The cleverest thing already on your site is turning an NDA into a design device with the REDACTED badges. This makes that the section language: every heading starts blacked out under a purple bar, and the bar slides off as you reach it. It is the one idea here that nobody else can copy, because it comes from your actual work.',
  },
  {
    id: 'sweep',
    name: 'F. Purple wavefront',
    why: 'The heading sits dim until you reach it, then a purple leading edge sweeps through the letters and leaves them bright white. Built with background-clip on the text itself, so the colour moves through the glyphs rather than behind them. Tied to scroll position, it makes the page feel like it is responding to you.',
  },
  {
    id: 'ghost',
    name: 'G. Ghost word',
    why: 'An oversized outlined word sits behind the heading at very low opacity, giving each section a second layer of meaning and a lot of visual weight without adding colour. Editorial rather than decorative. It also solves the real problem that these headings currently float in a lot of empty space.',
  },
  {
    id: 'boot',
    name: 'H. Command heading',
    why: 'Each section announces itself the way your terminal would: a purple prompt, the command that would get you there, a block cursor. The human-readable title sits underneath. This is the option that makes the whole page feel like one idea instead of a hero with a gimmick attached.',
  },
  {
    id: 'stagger',
    name: 'I. Letters rise',
    why: 'The title assembles itself letter by letter as it enters, each one lifting and sharpening from a slight blur. No colour trickery, purely motion. Works with any typeface and reads as craft rather than effect, but it is also the most conventional of the five.',
  },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Section title ideas</title>
  </head>
  <body>
    <header class="page-head">
      <h1>Section titles, round two</h1>
      <p>
        Five ideas that do something, rather than five ways to place an underline. Each
        plays as it scrolls into view. The current styling is at the bottom for comparison.
      </p>
      <button type="button" id="replay-all" class="replay-all">Replay everything</button>
    </header>

    {
      ideas.map((idea) => (
        <section class="block" data-idea={idea.id}>
          <div class="block-head">
            <h2>{idea.name}</h2>
            <p>{idea.why}</p>
            <button type="button" class="replay">Replay</button>
          </div>

          <div class="samples">
            {samples.map((s) => (
              <div class={`sample fx-${idea.id}`} style={`background-color: ${s.bg}`}>
                {idea.id === 'redact' && (
                  <h3 class="t-redact">
                    <span class="txt">{s.name}</span>
                    <span class="bar" />
                  </h3>
                )}

                {idea.id === 'sweep' && <h3 class="t-sweep">{s.name}</h3>}

                {idea.id === 'ghost' && (
                  <h3 class="t-ghost" data-ghost={s.ghost}>
                    <span>{s.name}</span>
                  </h3>
                )}

                {idea.id === 'boot' && (
                  <div class="t-boot">
                    <p class="cmd">
                      <span class="pr">rudy@portfolio:~$</span> <span class="typed">{s.cmd}</span>
                      <span class="cur" />
                    </p>
                    <h3>{s.name}</h3>
                  </div>
                )}

                {idea.id === 'stagger' && (
                  <h3 class="t-stagger">
                    {s.name.split('').map((ch, i) => (
                      <span style={`--i:${i}`}>{ch === ' ' ? ' ' : ch}</span>
                    ))}
                  </h3>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }

    <section class="block">
      <div class="block-head">
        <h2>Current</h2>
        <p>Weight 800, centred, 100px gradient stub. Here for comparison.</p>
      </div>
      <div class="samples">
        {samples.map((s) => (
          <div class="sample" style={`background-color: ${s.bg}`}>
            <h3 class="t-current">{s.name}</h3>
          </div>
        ))}
      </div>
    </section>
  </body>
</html>

<style>
  :root {
    --purple: rgb(153, 82, 228);
    --purple-dim: rgb(110, 58, 165);
    --mono: ui-monospace, 'Cascadia Code', 'Segoe UI Mono', Consolas, monospace;
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
  }

  body {
    padding: 3rem 2rem 8rem;
    max-width: 1150px;
    margin: 0 auto;
  }

  .page-head {
    padding-bottom: 2rem;
    border-bottom: 1px solid #2a2a2a;
  }

  .page-head h1 {
    font-size: 1.75rem;
    margin-bottom: 0.75rem;
  }

  .page-head p {
    color: #bbb;
    max-width: 68ch;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .replay-all,
  .replay {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--purple);
    background: rgba(153, 82, 228, 0.08);
    border: 1px solid rgba(153, 82, 228, 0.35);
    border-radius: 6px;
    padding: 0.35rem 0.75rem;
    cursor: pointer;
  }

  .replay-all:hover,
  .replay:hover {
    background: rgba(153, 82, 228, 0.18);
    color: #fff;
  }

  .block {
    padding: 2.75rem 0;
    border-bottom: 1px solid #2a2a2a;
  }

  .block-head h2 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .block-head p {
    color: #999;
    font-size: 0.92rem;
    line-height: 1.65;
    max-width: 74ch;
    margin-bottom: 1rem;
  }

  .samples {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .sample {
    padding: 3rem 1.5rem;
    border: 1px solid #262626;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 190px;
    overflow: hidden;
  }

  h3 {
    margin: 0;
    text-align: center;
  }

  /* ====================================================================
     E. Redaction lift
     Text sits under a purple bar; the bar slides right and the letters
     are uncovered exactly as its edge passes them.
  ==================================================================== */
  .t-redact {
    position: relative;
    display: inline-block;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    padding: 0.1em 0.25em;
  }

  .t-redact .txt {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
  }

  .t-redact .bar {
    position: absolute;
    inset: 0;
    background: var(--purple);
    transform: translateX(0);
  }

  .fx-redact.play .txt {
    animation: redact-text 900ms var(--ease) forwards;
  }

  .fx-redact.play .bar {
    animation: redact-bar 900ms var(--ease) forwards;
  }

  @keyframes redact-text {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes redact-bar {
    to {
      transform: translateX(101%);
    }
  }

  /* ====================================================================
     F. Purple wavefront
     A gradient wider than the text is clipped to the glyphs and slid
     across, so the colour travels through the letterforms.
  ==================================================================== */
  .t-sweep {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    background-image: linear-gradient(
      100deg,
      #ffffff 0%,
      #ffffff 28%,
      var(--purple) 38%,
      #5a5a5a 48%,
      #5a5a5a 100%
    );
    background-size: 320% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .fx-sweep.play .t-sweep {
    animation: sweep 1100ms var(--ease) forwards;
  }

  @keyframes sweep {
    to {
      background-position: 0% 0;
    }
  }

  /* ====================================================================
     G. Ghost word
  ==================================================================== */
  .t-ghost {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .t-ghost::before {
    content: attr(data-ghost);
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(1.06);
    font-size: 3.4em;
    font-weight: 800;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.11);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
  }

  .t-ghost span {
    position: relative;
  }

  .fx-ghost.play .t-ghost::before {
    animation: ghost-in 1200ms var(--ease) forwards;
  }

  @keyframes ghost-in {
    from {
      opacity: 0;
      transform: translate(-50%, -50%) scale(1.18);
    }
    to {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.06);
    }
  }

  /* ====================================================================
     H. Command heading
  ==================================================================== */
  .t-boot {
    text-align: center;
  }

  .t-boot .cmd {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: #d8d8d8;
    margin-bottom: 0.7rem;
    white-space: nowrap;
  }

  .t-boot .pr {
    color: var(--purple);
    font-weight: 600;
  }

  .t-boot .typed {
    clip-path: inset(0 100% 0 0);
    display: inline-block;
    vertical-align: bottom;
  }

  .t-boot .cur {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    background: var(--purple);
    vertical-align: text-bottom;
    margin-left: 0.1em;
    animation: blink 1.05s steps(1) infinite;
  }

  .t-boot h3 {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
    opacity: 0;
  }

  .fx-boot.play .typed {
    animation: type-in 700ms steps(18) forwards;
  }

  .fx-boot.play h3 {
    animation: title-in 600ms var(--ease) 620ms forwards;
  }

  @keyframes type-in {
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes title-in {
    from {
      opacity: 0;
      transform: translateY(0.4rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes blink {
    0%,
    50% {
      opacity: 1;
    }
    51%,
    100% {
      opacity: 0;
    }
  }

  /* ====================================================================
     I. Letters rise
  ==================================================================== */
  .t-stagger {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .t-stagger span {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.5em);
    filter: blur(6px);
  }

  .fx-stagger.play .t-stagger span {
    animation: char-rise 620ms var(--ease) forwards;
    animation-delay: calc(var(--i) * 42ms);
  }

  @keyframes char-rise {
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  /* ---- current -------------------------------------------------------- */
  .t-current {
    font-size: 2.5rem;
    font-weight: 800;
    color: #fff;
    position: relative;
    padding-bottom: 1rem;
  }

  .t-current::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100px;
    height: 4px;
    background: linear-gradient(90deg, transparent, var(--purple), transparent);
  }

  @media (max-width: 820px) {
    .samples {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const samples = document.querySelectorAll('.sample[class*="fx-"]');

  function play(el: Element) {
    el.classList.remove('play');
    // force a reflow so the animation can be restarted
    void (el as HTMLElement).offsetWidth;
    el.classList.add('play');
  }

  // play each one as it comes into view
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) play(entry.target);
      }
    },
    { threshold: 0.4 }
  );
  samples.forEach((s) => io.observe(s));

  document.querySelectorAll('.replay').forEach((btn) => {
    btn.addEventListener('click', () => {
      btn.closest('.block')?.querySelectorAll('.sample[class*="fx-"]').forEach(play);
    });
  });

  document.getElementById('replay-all')?.addEventListener('click', () => {
    samples.forEach(play);
  });
</script>
